# Copy this file to .env and set an absolute path for the current OS.
# Windows example: C:/Users/username/.android/gagauzium-debug.keystore
# Ubuntu example: /home/username/.android/gagauzium-debug.keystore
FLET_ANDROID_SIGNING_KEY_STORE="/absolute/path/to/gagauzium-debug.keystore"

# The standard Android debug keystore uses "android" for both passwords.
# Replace these values if the original Ubuntu keystore used other passwords.
FLET_ANDROID_SIGNING_KEY_STORE_PASSWORD="android"
FLET_ANDROID_SIGNING_KEY_PASSWORD="android"
FLET_ANDROID_SIGNING_KEY_ALIAS="androiddebugkey"
